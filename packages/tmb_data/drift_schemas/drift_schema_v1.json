  "fixed_sql": [
    {
      "name": "sessions",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sessions\" (\"id\" TEXT NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NULL, \"utc_offset_min\" INTEGER NOT NULL, \"location\" TEXT NOT NULL, \"difficulty\" TEXT NOT NULL, \"template\" TEXT NOT NULL, \"app_version\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (ended_at IS NULL OR ended_at >= started_at), CHECK (utc_offset_min BETWEEN -720 AND 840));"
        }
      ]
    },
    {
      "name": "round_logs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"round_logs\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"block_index\" INTEGER NOT NULL, \"round_index\" INTEGER NOT NULL, \"duration_ms\" INTEGER NOT NULL, \"rpe\" INTEGER NULL, PRIMARY KEY (\"id\"), CHECK (block_index >= 0 AND round_index >= 0 AND duration_ms >= 0), CHECK (rpe IS NULL OR rpe BETWEEN 1 AND 3));"
        }
      ]
    },
    {
      "name": "exercise_sets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_sets\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"round_id\" TEXT NOT NULL REFERENCES round_logs (id) ON DELETE CASCADE, \"set_index\" INTEGER NOT NULL, \"exercise_id\" TEXT NOT NULL, \"unit\" TEXT NOT NULL, \"prescribed\" INTEGER NOT NULL, \"done\" INTEGER NOT NULL, \"started_at\" INTEGER NOT NULL, \"ended_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (set_index >= 0), CHECK (prescribed BETWEEN 1 AND 3600), CHECK (done BETWEEN 0 AND 3600), CHECK (ended_at >= started_at));"
        }
      ]
    },
    {
      "name": "task_attempts",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"task_attempts\" (\"id\" TEXT NOT NULL, \"session_id\" TEXT NOT NULL REFERENCES sessions (id) ON DELETE CASCADE, \"block_index\" INTEGER NOT NULL, \"round_index\" INTEGER NOT NULL, \"task_id\" TEXT NOT NULL, \"pack_id\" TEXT NOT NULL, \"pack_source\" TEXT NOT NULL, \"archetype\" TEXT NOT NULL, \"domain\" TEXT NOT NULL, \"difficulty\" REAL NOT NULL, \"seed\" INTEGER NOT NULL, \"status\" TEXT NOT NULL, \"presented_at\" INTEGER NOT NULL, \"answered_at\" INTEGER NULL, \"latency_ms\" INTEGER NULL, \"is_correct\" INTEGER NULL CHECK (\"is_correct\" IN (0, 1)), \"self_rating\" INTEGER NULL, \"response\" TEXT NULL, \"encoded_round_index\" INTEGER NULL, \"payload_hash\" TEXT NOT NULL, PRIMARY KEY (\"id\"), CHECK (block_index >= 0 AND round_index >= 0), CHECK (difficulty BETWEEN 0 AND 1), CHECK (seed BETWEEN 0 AND 9007199254740991), CHECK (status IN ('answered', 'timeout', 'skipped')), CHECK ((status = 'answered') = (answered_at IS NOT NULL)), CHECK ((status = 'answered') = (latency_ms IS NOT NULL)), CHECK (latency_ms IS NULL OR latency_ms >= 0), CHECK (answered_at IS NULL OR answered_at >= presented_at), CHECK (self_rating IS NULL OR self_rating BETWEEN 0 AND 3), CHECK (encoded_round_index IS NULL OR (encoded_round_index >= 0 AND encoded_round_index <= round_index)), CHECK (length(payload_hash) = 64));"
        }
      ]
    },
    {
      "name": "profile_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"profile_settings\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"schema_version\" INTEGER NOT NULL DEFAULT 1, \"default_reps_min\" INTEGER NOT NULL DEFAULT 15, \"default_reps_max\" INTEGER NOT NULL DEFAULT 15, \"default_seconds_min\" INTEGER NOT NULL DEFAULT 30, \"default_seconds_max\" INTEGER NOT NULL DEFAULT 30, \"progression_enabled\" INTEGER NOT NULL DEFAULT 1 CHECK (\"progression_enabled\" IN (0, 1)), PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (default_reps_min >= 1 AND default_reps_min <= default_reps_max AND default_reps_max <= 3600), CHECK (default_seconds_min >= 1 AND default_seconds_min <= default_seconds_max AND default_seconds_max <= 3600));"
        }
      ]
    },
    {
      "name": "disabled_categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"disabled_categories\" (\"path\" TEXT NOT NULL, PRIMARY KEY (\"path\"));"
        }
      ]
    },
    {
      "name": "exercise_targets",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"exercise_targets\" (\"exercise_id\" TEXT NOT NULL, \"target_min\" INTEGER NOT NULL, \"target_max\" INTEGER NOT NULL, \"locked_by_user\" INTEGER NOT NULL DEFAULT 0 CHECK (\"locked_by_user\" IN (0, 1)), PRIMARY KEY (\"exercise_id\"), CHECK (target_min >= 1 AND target_min <= target_max AND target_max <= 3600));"
        }
      ]
    },
    {
      "name": "session_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"session_preferences\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"template\" TEXT NOT NULL DEFAULT 'dual_task', \"rounds\" INTEGER NOT NULL DEFAULT 5, \"cognitive_sec\" INTEGER NOT NULL DEFAULT 180, \"rest_sec\" INTEGER NOT NULL DEFAULT 0, \"location\" TEXT NOT NULL DEFAULT 'HOME', \"difficulty\" TEXT NOT NULL DEFAULT 'recruit', PRIMARY KEY (\"id\"), CHECK (id = 1), CHECK (rounds >= 1 AND cognitive_sec >= 0 AND rest_sec >= 0));"
        }
      ]
    },
    {
      "name": "user_packs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"user_packs\" (\"kind\" TEXT NOT NULL, \"pack_id\" TEXT NOT NULL, \"pack_source\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"locale\" TEXT NOT NULL, \"item_count\" INTEGER NOT NULL, \"installed_at\" INTEGER NOT NULL, \"content\" TEXT NOT NULL, PRIMARY KEY (\"kind\", \"pack_id\"), CHECK (kind IN ('task_pack', 'exercise_pack')), CHECK (pack_source IN ('imported', 'user')));"
        }
      ]
    },
